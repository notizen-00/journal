{
  "name": "journal-publisher",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @journal/database generate",
    "db:migrate": "pnpm --filter @journal/database migrate:dev",
    "db:deploy": "pnpm --filter @journal/database migrate:deploy",
    "db:seed": "pnpm --filter @journal/database seed"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}
