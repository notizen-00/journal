# ---- Postgres ----
POSTGRES_USER=journal
POSTGRES_PASSWORD=journal
POSTGRES_DB=journal_publisher
POSTGRES_PORT=5432
DATABASE_URL=postgresql://journal:journal@postgres:5432/journal_publisher?schema=public

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ---- MinIO ----
MINIO_ROOT_USER=journaladmin
MINIO_ROOT_PASSWORD=journalsecret
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
MINIO_BUCKET=journal-media
MINIO_PUBLIC_URL=http://localhost:9000/journal-media

# ---- API (NestJS) ----
API_PORT=3000
API_BASE_URL=http://api:3000
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:8080,http://localhost:5174
# Shared secret between api and worker for the build-time public data feed (PRD §24, §32)
INTERNAL_API_TOKEN=change-me-in-production
SEED_ADMIN_EMAIL=admin@unej.ac.id
SEED_ADMIN_PASSWORD=change-me-in-production

# ---- Admin (SvelteKit) ----
ADMIN_PORT=5174
PUBLIC_API_BASE_URL=http://localhost:3000

# ---- Worker / Static Build ----
BUILD_OUTPUT_DIR=/data/releases
BUILD_CONCURRENCY=1
# Auto OAI sync interval in ms (PRD §8 - "Every 10 minutes" = 600000)
OAI_SYNC_INTERVAL_MS=600000

# ---- Nginx ----
NGINX_PORT=8080
# Journal served at "/" until multi-domain server blocks are added (PRD §28)
DEFAULT_JOURNAL_ID=default
