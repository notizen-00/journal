# Public entrypoint (PRD §4, §24, §28):
#   /            -> static release for DEFAULT_JOURNAL_ID (releases/<id>/current)
#   /admin/      -> Journal Publisher admin dashboard (SvelteKit, adapter-node)
#   /api/        -> Journal Publisher API (auth-guarded, used by the admin UI)
#
# Multi-domain (PRD §28): duplicate this server block per `server_name`,
# each pointing `root` at its own journal's releases/<journalId>/current.
server {
    listen 80;
    server_name _;

    root /data/releases/${DEFAULT_JOURNAL_ID}/current;
    index index.html;

    location / {
        try_files $uri $uri/ $uri/index.html =404;
    }

    location /admin/ {
        proxy_pass http://admin:3000/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        proxy_pass http://api:3000/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    error_page 404 /index.html;
}
